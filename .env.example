# Copie para .env e ajuste. Nunca faça commit do .env.
JOBFINDER_DB=dados/job_finder.db
JOBFINDER_PERFIL=perfil.yaml

# Ollama nativo no Mac
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3:4b

# Coleta automática (horas entre execuções; 0 desliga o agendador)
JOBFINDER_INTERVALO_HORAS=3

# Opcional: token do GitHub (só leitura de repositórios públicos) para subir o limite de 60 para 5000 requisições/hora
GITHUB_TOKEN=

# Opcional: alertas de vaga do LinkedIn e Indeed pelo Gmail (IMAP + senha de app)
IMAP_HOST=imap.gmail.com
IMAP_USUARIO=
IMAP_SENHA_APP=
IMAP_PASTA=INBOX
